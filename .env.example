# Core Application Config
DATABASE_URL=sqlite:///data/movies_recommender.db
APP_ENV=development
AUTO_INIT_DB=false
USE_MOCK_DATA=false
ENABLE_STARTUP_WARMUP=true

# API Keys
TMDB_API_KEY=your_tmdb_key_here
GROQ_API_KEY=your_groq_key_here
COHERE_API_KEY=your_cohere_key_here
PHD_SECRET_KEY=replace_with_strong_secret

# Service URLs
QDRANT_URL=http://localhost:6345
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Frontend/Auth
AUTH_SECRET=replace_with_strong_auth_secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8001
API_URL=http://localhost:8001

# Security
CORS_ALLOW_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
